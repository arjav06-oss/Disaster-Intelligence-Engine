# ============================================
# Disaster Intelligence Engine - .gitignore
# ============================================
# This file tells Git which files/folders to ignore
# (i.e., not track in version control).

# --- Python bytecode and cache ---
# Python compiles .py files to .pyc for speed; these are auto-generated
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# --- Virtual Environment ---
# The venv folder contains installed packages; it should NOT be committed
# because anyone can recreate it using: pip install -r requirements.txt
venv/
env/
.venv/

# --- IDE settings ---
# Editor-specific config files that differ per developer
.vscode/
.idea/
*.swp
*.swo

# --- Jupyter Notebook checkpoints ---
# Auto-save backups created by Jupyter
.ipynb_checkpoints/

# --- Project-specific: Raw data ---
# The raw dataset files are too large for Git.
# Users must download them separately (see README.md).
data/raw/*.tsv
data/raw/*.csv

# --- Project-specific: Processed data ---
# These CSV files are auto-generated by the pipeline
data/processed/*.csv

# --- Project-specific: Trained models ---
# Model .pkl files are large binary files, auto-generated by train.py
models/*.pkl

# NOTE: We DO track models/model_results.json (small JSON with metrics)

# --- Operating System files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Environment variables ---
.env
.env.local
